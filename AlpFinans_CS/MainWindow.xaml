                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Satıcı / Tedarikçi Firma:" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtScanVendor" Text="" Height="40" TextChanged="ScanForm_Recalculate"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Fatura Başlığı / Malzeme Açıklaması:" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtScanTitle" Text="" Height="40"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: Kategori & Harcama Niteliği -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="VUK Demirbaş &amp; Harcama Kategorisi:" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbScanCategory" Height="40" SelectionChanged="ScanForm_Recalculate">
                                        <ComboBoxItem Content="⚡ Elektrik Faturası (Aydem / Enerjisa vb.)" IsSelected="True"/>
                                        <ComboBoxItem Content="💧 Su Faturası (MUSKİ vb.)"/>
                                        <ComboBoxItem Content="🌐 İnternet &amp; Telefon (Türk Telekom vb.)"/>
                                        <ComboBoxItem Content="💻 Bilgisayar, Tablet, Yazıcı &amp; Donanım"/>
                                        <ComboBoxItem Content="🔨 Villa Tadilat, Bakım &amp; Onarım"/>
                                        <ComboBoxItem Content="📦 Doğrudan Sarf / Temizlik / Hizmet"/>
                                        <ComboBoxItem Content="🛏️ Villa Mobilyası &amp; Beyaz Eşya"/>
                                        <ComboBoxItem Content="🏊 Havuz Ekipmanı &amp; Arıtma"/>
                                        <ComboBoxItem Content="🚗 Araç / Yakıt / Ulaşım"/>
                                        <ComboBoxItem Content="🛒 Market / Ofis Gideri"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Harcama Niteliği:" FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbScanType" Height="40" SelectionChanged="ScanForm_Recalculate">
                                        <ComboBoxItem Content="🏢 Şirket / Villa Gideri (Vergi Kalkanı)" IsSelected="True"/>
                                        <ComboBoxItem Content="👤 Kişisel Harcama (Vergiden Düşmez)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Live Tax Shield Banner -->
                            <Border Background="#090E1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🛡️" FontSize="16" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="TxtScanTaxShield" Text="Fatura Vergi Kalkanı: ₺0,00 (KDV + Gelir Vergisi Tasarrufu)" FontSize="13" FontWeight="SemiBold" Foreground="#34D399"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtScanFileName" Text="" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="#64748B"/>
                                </Grid>
                            </Border>

                            <!-- Big Green Save Button (Anchored Lower, No Empty Void) -->
                            <Button x:Name="BtnSaveScannedExpense" Content="💾 Faturayı Kaydet ve Vergi Kalkanına Ekle" Height="48" Background="#10B981" Foreground="#FFFFFF" BorderThickness="0" FontSize="14" FontWeight="Bold" Click="BtnSaveScannedExpense_Click" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- ==================== VIEW 3: FATURALAR & GİDER HAKLARI ==================== -->
                <Grid x:Name="ViewExpenses" Margin="24,16,24,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search & Filter Chips -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0D1424" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Tümü" Style="{StaticResource ChipButtonStyle}" Click="ExpenseChip_Click" Tag=""/>
                                <Button Content="🏢 Şirket Gideri" Style="{StaticResource ChipButtonStyle}" Click="ExpenseChip_Click" Tag="sirket_gideri"/>
                                <Button Content="👤 Kişisel" Style="{StaticResource ChipButtonStyle}" Click="ExpenseChip_Click" Tag="kisisel_harcama"/>
                                <Button Content="⚡ Faturalar" Style="{StaticResource ChipButtonStyle}" Click="ExpenseChip_Click" Tag="fatura"/>
                                <Button Content="🔨 Tadilat" Style="{StaticResource ChipButtonStyle}" Click="ExpenseChip_Click" Tag="tadilat"/>
                                <Button Content="💻 Teknoloji" Style="{StaticResource ChipButtonStyle}" Click="ExpenseChip_Click" Tag="bilgisayar"/>
                            </StackPanel>

                            <TextBox x:Name="TxtExpenseFilter" Grid.Column="1" Margin="14,0" Height="36" TextChanged="TxtExpenseFilter_TextChanged"/>

                            <Button Grid.Column="2" Content="+ Yeni Fatura Ekle" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5" Padding="16,8" Cursor="Hand" Click="BtnAddExpense_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="GridExpenses" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TARİH" Binding="{Binding InvoiceDate}" Width="110"/>
                            <DataGridTextColumn Header="FİRMA / SATICI" Binding="{Binding VendorName}" Width="160"/>
                            <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Title}" Width="*"/>
                            <DataGridTemplateColumn Header="TÜR" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TypeBadgeBg}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding TypeBadgeText}" Foreground="{Binding TypeBadgeFg}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="BRÜT TUTAR" Binding="{Binding FormattedGross}" Width="120"/>
                            <DataGridTextColumn Header="KDV" Binding="{Binding FormattedKdv}" Width="110"/>
                            <DataGridTextColumn Header="VERGİ KALKANI" Binding="{Binding FormattedShield}" Width="120"/>
                            <DataGridTemplateColumn Header="İŞLEM" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🗑️" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnDeleteExpense_Click" Tag="{Binding Id}" ToolTip="Sil"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ==================== VIEW 4: GELİRLER & HAKEDİŞ ==================== -->
                <Grid x:Name="ViewIncomes" Margin="24,16,24,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0D1424" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Tümü" Style="{StaticResource ChipButtonStyle}" Click="IncomeChip_Click" Tag=""/>
                                <Button Content="🏡 Villa Hakediş" Style="{StaticResource ChipButtonStyle}" Click="IncomeChip_Click" Tag="villa_hakedis"/>
                                <Button Content="🏢 Şirket Faturası" Style="{StaticResource ChipButtonStyle}" Click="IncomeChip_Click" Tag="sirket_fatura"/>
                                <Button Content="🛡️ Vergisiz İstisna" Style="{StaticResource ChipButtonStyle}" Click="IncomeChip_Click" Tag="vergisiz_kazanc"/>
                            </StackPanel>

                            <TextBox x:Name="TxtIncomeFilter" Grid.Column="1" Margin="14,0" Height="36" TextChanged="TxtIncomeFilter_TextChanged"/>

                            <Button Grid.Column="2" Content="+ Yeni Gelir Ekle" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5" Padding="16,8" Cursor="Hand" Click="BtnAddIncome_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="GridIncomes" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TARİH" Binding="{Binding InvoiceDate}" Width="110"/>
                            <DataGridTextColumn Header="MÜŞTERİ / KAYNAK" Binding="{Binding ClientName}" Width="160"/>
                            <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="BRÜT TUTAR" Binding="{Binding FormattedGross}" Width="130"/>
                            <DataGridTextColumn Header="KDV" Binding="{Binding FormattedKdv}" Width="110"/>
                            <DataGridTextColumn Header="STOPAJ" Binding="{Binding FormattedStopaj}" Width="100"/>
                            <DataGridTextColumn Header="NET TAHSİLAT" Binding="{Binding FormattedNet}" Width="130"/>
                            <DataGridTemplateColumn Header="İŞLEM" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnDeleteIncome_Click" Tag="{Binding Id}" ToolTip="Sil"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ==================== VIEW 5: ŞİRKET & VERGİ PROFİLİ ==================== -->
                <ScrollViewer x:Name="ViewSettings" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16,24,24" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Company Profile Settings Card -->
                        <Border Background="#0D1424" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="🏢  Şirket &amp; Vergi Rejimi Ayarları" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Şirket Türü:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CmbCompanyType">
                                            <ComboBoxItem Content="Şahıs Şirketi (Artan Oranlı Gelir Vergisi %15-%40)" IsSelected="True"/>
                                            <ComboBoxItem Content="Limited Şirket (Sabit Kurumlar Vergisi %25)"/>
                                            <ComboBoxItem Content="Anonim Şirket (Sabit Kurumlar Vergisi %25)"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Sabit Gelir Vergisi Oranı (%):" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtFixedTaxRate" Text="20"/>
                                    </StackPanel>
                                </Grid>

                                <CheckBox x:Name="ChkYoungEntrepreneur" Content="₺230.000 Genç Girişimci Gelir Vergisi İstisnasından Yararlanıyorum" Foreground="#F8FAFC" FontSize="13" Margin="0,0,0,16"/>

                                <Button Content="💾 Ayarları Kaydet" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Padding="20,10" HorizontalAlignment="Left" Cursor="Hand" Click="BtnSaveSettings_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Official Tax Accruals (Tahakkuklar & Damga Vergisi) -->
                        <Border Background="#0D1424" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="📋  Resmi Vergi Dairesi Tahakkuk Fişleri &amp; Damga Vergileri" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14"/>

                                <DataGrid x:Name="GridAccruals" Height="280">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="SON ÖDEME" Binding="{Binding DueDate}" Width="110"/>
                                        <DataGridTextColumn Header="TÜR" Binding="{Binding TaxType}" Width="130"/>
                                        <DataGridTextColumn Header="AÇIKLAMA" Binding="{Binding Title}" Width="*"/>
                                        <DataGridTextColumn Header="TUTAR" Binding="{Binding FormattedAmount}" Width="120"/>
                                        <DataGridTextColumn Header="DÖNEM" Binding="{Binding Period}" Width="100"/>
                                        <DataGridTemplateColumn Header="DURUM" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding StatusBg}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="İŞLEM" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding ActionButtonText}" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" Padding="6,2" FontSize="11" Cursor="Hand" Click="BtnToggleAccrualPaid_Click" Tag="{Binding Id}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
