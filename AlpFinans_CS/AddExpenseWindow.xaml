<Window x:Class="AlpFinans.AddExpenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Fatura / Gider Ekle"
        Height="590" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F17" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📄 Yeni Fatura / Gider Kaydı" FontSize="18" FontWeight="Bold" Foreground="#F43F5E" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Fatura / Harcama Açıklaması *" Foreground="#94A3B8" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtTitle" Height="36" Background="#131B2A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Gider Türü" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbExpenseType" Height="36" Background="#131B2A" Foreground="#F8FAFC" SelectedIndex="0">
                        <ComboBoxItem Content="🏢 Şirket Gideri (Vergi Kalkanı)" Tag="sirket_gideri"/>
                        <ComboBoxItem Content="👤 Kişisel Harcama" Tag="kisisel_harcama"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Kategori" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbCategory" Height="36" Background="#131B2A" Foreground="#F8FAFC" SelectedIndex="0">
                        <ComboBoxItem Content="💻 Teknoloji &amp; Donanım" Tag="teknoloji_yazilim"/>
                        <ComboBoxItem Content="🔨 Tadilat &amp; Bakım" Tag="tadilat_insaat"/>
                        <ComboBoxItem Content="🧊 Beyaz Eşya" Tag="beyaz_esya"/>
                        <ComboBoxItem Content="🛋️ Mobilya &amp; Dekorasyon" Tag="villa_esya_mobilya"/>
                        <ComboBoxItem Content="🏊 Havuz Ekipmanı" Tag="havuz_ekipmani"/>
                        <ComboBoxItem Content="📦 Genel Ofis / İş Gideri" Tag="dogrudan_gider"/>
                        <ComboBoxItem Content="⚡ Faturalar (Elektrik, Su, Net)" Tag="faturalar"/>
                        <ComboBoxItem Content="⛽ Ulaşım &amp; Yakıt" Tag="ulasim_yakit"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Toplam Tutar (KDV Dahil ₺) *" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtGross" Height="36" Background="#131B2A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,6" TextChanged="CalculateShield_Event"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="KDV Oranı" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbKdv" Height="36" Background="#131B2A" Foreground="#F8FAFC" SelectedIndex="0" SelectionChanged="CalculateShield_Event">
                        <ComboBoxItem Content="%20 KDV" Tag="20"/>
                        <ComboBoxItem Content="%10 KDV" Tag="10"/>
                        <ComboBoxItem Content="%1 KDV" Tag="1"/>
                        <ComboBoxItem Content="%0 KDV" Tag="0"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Tedarikçi / Firma Adı" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtVendor" Height="36" Background="#131B2A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Fatura No / ETTN" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtInvoiceNo" Height="36" Background="#131B2A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,6"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Fatura Tarihi" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <DatePicker x:Name="DpDate" Height="36" Background="#131B2A" Foreground="#F8FAFC"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Belge Dosya Yolu (Opsiyonel)" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtReceiptFile" Height="36" Background="#131B2A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,6"/>
                </StackPanel>
            </Grid>

            <!-- Tax Shield Feedback -->
            <Border Background="#131B2A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4,0,0">
                <TextBlock x:Name="TxtShieldCalcDisplay" Text="🛡️ Tahmini Vergi Tasarrufu: ₺0.00" FontWeight="SemiBold" Foreground="#F59E0B"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="İptal" Width="100" Height="36" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancel_Click"/>
            <Button Content="💾 Faturayı Kaydet" Width="150" Height="36" Background="#F43F5E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
