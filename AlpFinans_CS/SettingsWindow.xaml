<Window x:Class="AlpFinans.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vergi ve Şirket Ayarları"
        Height="420" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F17" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="⚙️ Vergi &amp; Şirket Profili Ayarları" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Şirket Türü" Foreground="#94A3B8" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbCompanyType" Height="36" Background="#131B2A" Foreground="#F8FAFC" SelectedIndex="0" Margin="0,0,0,16">
                <ComboBoxItem Content="Şahıs Şirketi (Artan Oranlı Gelir Vergisi %15-%40)" Tag="sahis"/>
                <ComboBoxItem Content="Limited Şirket (Sabit Kurumlar Vergisi %25)" Tag="limited"/>
                <ComboBoxItem Content="Anonim Şirket (Sabit Kurumlar Vergisi %25)" Tag="anonim"/>
            </ComboBox>

            <CheckBox x:Name="ChkYoungEntrepreneur" IsChecked="True" Content="Genç Girişimci İstisnası Aktif (Yıllık ₺230.000 Matrah Muafiyeti)" Foreground="#F8FAFC" FontSize="13" Margin="0,0,0,16"/>

            <TextBlock Text="Veri Tabanı Dosya Yolu:" Foreground="#64748B" FontSize="11" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtDbPath" Text="..." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="İptal" Width="90" Height="36" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancel_Click"/>
            <Button Content="💾 Ayarları Kaydet" Width="140" Height="36" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
